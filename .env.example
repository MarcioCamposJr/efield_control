# Local hardware endpoints. Copy this file to .env and update it for the local
# installation. The .env file is intentionally ignored by Git.

# Red Pitaya IPv4 address or hostname and SCPI server TCP port.
EFIELD_RED_PITAYA_HOST=169.254.0.10
EFIELD_RED_PITAYA_PORT=5000

# Elfin controller IPv4 address or hostname. This is not used by circular-only
# mapping, where the Arduino moves the stage.
EFIELD_ROBOT_HOST=169.254.0.20

# USB serial port used by the Arduino hemispherical stage. On Windows this is
# typically COM3; on Linux it may resemble /dev/ttyACM0. This connection moves
# the servos even when the Red Pitaya is selected as the pulse source.
EFIELD_STAGE_SERIAL_PORT=COM3

# These values must match Serial.begin(...) in the Arduino firmware. Timeout is
# the maximum time to wait for an Arduino response to each command.
EFIELD_STAGE_SERIAL_BAUD=115200
EFIELD_STAGE_SERIAL_TIMEOUT_S=3.0

# External mTMS installation on the Linux/Ubuntu control host. The API path may
# identify MTMSApi.py itself or the directory containing it. The ROS setup
# defaults to /opt/ros/jazzy/setup.bash when this second variable is omitted.
EFIELD_MTMS_API_PATH=/home/user/mtms/api/python/MTMSApi.py
EFIELD_MTMS_ROS_SETUP=/opt/ros/jazzy/setup.bash
